# ICICI environment mode: UAT or PROD
ICICI_ENV_MODE=UAT

# UAT example host can differ from production host. Confirm with onboarding team.
ICICI_BASE_URL=https://pgpay.icicibank.com
ICICI_INITIATE_PATH=/pg/api/v2/initiateSale
ICICI_TXN_STATUS_PATH=/pg/api/v2/transactionStatus

ICICI_MERCHANT_ID=YOUR_MERCHANT_ID
ICICI_AGGREGATOR_ID=YOUR_AGGREGATOR_ID
ICICI_MERCHANT_KEY=YOUR_HASH_SECRET
ICICI_HASH_VERSION=v1

# Backend callback/advice endpoints
ICICI_RETURN_URL=https://your-domain.com/api/payments/icici/callback
ICICI_PAYMENT_ADVICE_URL=https://your-domain.com/api/payments/icici/advice

# Frontend status page
NEXT_PUBLIC_PAYMENT_STATUS_BASE_URL=https://your-domain.com/payment/status

# Networking and reconciliation controls
ICICI_TIMEOUT_MS=15000
ICICI_RECONCILE_MAX_ATTEMPTS=5

# SMSCountry OTP integration
SMSCOUNTRY_API_URL=https://www.smscountry.com/SMSCwebservice_Bulk.aspx
SMSCOUNTRY_USERNAME=YOUR_SMSCOUNTRY_USERNAME
SMSCOUNTRY_PASSWORD=YOUR_SMSCOUNTRY_PASSWORD
SMSCOUNTRY_SENDER_ID=YOUR_SENDER_ID
SMSCOUNTRY_OTP_TEMPLATE=Your OTP is {otp}. It is valid for 5 minutes.


# SMSCountry OTP integration
SMSCOUNTRY_AUTH_KEY=
SMSCOUNTRY_AUTH_TOKEN=
SMSCOUNTRY_SENDER_ID=
SMSCOUNTRY_AUTH_KEY_BASE64=

# Optional (use if your SMSCountry setup requires DLT data / custom endpoint)
SMSCOUNTRY_ACCOUNT_ID=
SMSCOUNTRY_TEMPLATE_ID=
SMSCOUNTRY_ENTITY_ID=
SMSCOUNTRY_COUNTRY_CODE=91
SMSCOUNTRY_BASE_URL=https://restapi.smscountry.com
SMSCOUNTRY_SEND_PATH=/v0.1/Accounts/${SMSCOUNTRY_AUTH_KEY}/SMSes/RequestAttributes
SMSCOUNTRY_REQUEST_FORMAT=json
SMSCOUNTRY_AUTH_HEADER=
SMSCOUNTRY_OTP_MESSAGE=Dear User, {{OTP}} is the OTP for New user registration on the Charak HealthTech app
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
